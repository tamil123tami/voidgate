# VoidGate Configuration
# Copy this to .env and fill in your actual API keys

# ===== LLM API Keys =====
# Get Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API key (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== Cache Configuration =====
# Semantic similarity threshold (0.0-1.0, default: 0.92)
SEMANTIC_THRESHOLD=0.92

# ===== Local SLM Configuration =====
# Ollama server URL (install Ollama from https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ===== Redis Configuration (optional, for production) =====
REDIS_URL=redis://localhost:6379

# ===== Database Configuration =====
DB_PATH=voidgate_metrics.db

# ===== Failover Settings =====
SIMULATE_FAILOVER=false
FAILOVER_TRIGGER_TOKEN=20

# ===== Advanced Config (Avoid Hardcoding) =====
PRIMARY_CLOUD_MODEL=llama-3.3-70b-versatile
FAILOVER_CLOUD_MODEL=gemini-1.5-pro
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8001

